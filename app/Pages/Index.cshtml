@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-4">Expense Management System</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-plus-circle"></i> Add Expense
                    </h5>
                    <p class="card-text">Create a new expense entry</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                        Add New Expense
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-list-ul"></i> View Expenses
                    </h5>
                    <p class="card-text">Browse all expense entries</p>
                    <button class="btn btn-info text-white" onclick="loadExpenses()">
                        View All
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-check-circle"></i> Approve Expenses
                    </h5>
                    <p class="card-text">Review pending expenses</p>
                    <button class="btn btn-success" onclick="loadPendingExpenses()">
                        Review Pending
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="filterText" class="form-control" placeholder="Filter expenses..." onkeyup="filterExpenses()">
        </div>
        <div class="col-md-3">
            <select id="statusFilter" class="form-select" onchange="filterByStatus()">
                <option value="">All Statuses</option>
                <option value="Draft">Draft</option>
                <option value="Submitted">Submitted</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">Clear Filters</button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Expenses</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="expenseTableBody">
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        Click "View All" to load expenses
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addExpenseModalLabel">Add Expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addExpenseForm">
                    <div class="mb-3">
                        <label for="expenseAmount" class="form-label">Amount (£)</label>
                        <input type="number" step="0.01" class="form-control" id="expenseAmount" required>
                    </div>
                    <div class="mb-3">
                        <label for="expenseDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="expenseDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="expenseCategory" class="form-label">Category</label>
                        <select class="form-select" id="expenseCategory" required>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="expenseDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="expenseDescription" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitExpense()">Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approveModalLabel">Review Expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to <strong id="approveAction"></strong> this expense?</p>
                <div id="approveExpenseDetails"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmApprove" onclick="confirmApprove()">Approve</button>
                <button type="button" class="btn btn-danger" id="confirmReject" onclick="confirmReject()">Reject</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentExpenses = [];
        let currentExpenseId = null;

        async function loadExpenses() {
            try {
                const response = await fetch('/api/Expenses');
                const expenses = await response.json();
                currentExpenses = expenses;
                displayExpenses(expenses);
            } catch (error) {
                console.error('Error loading expenses:', error);
                alert('Failed to load expenses');
            }
        }

        async function loadPendingExpenses() {
            try {
                const response = await fetch('/api/Expenses/pending');
                const expenses = await response.json();
                currentExpenses = expenses;
                displayExpenses(expenses);
            } catch (error) {
                console.error('Error loading pending expenses:', error);
                alert('Failed to load pending expenses');
            }
        }

        function displayExpenses(expenses) {
            const tbody = document.getElementById('expenseTableBody');
            if (expenses.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No expenses found</td></tr>';
                return;
            }

            tbody.innerHTML = expenses.map(expense => `
                <tr>
                    <td>${new Date(expense.expenseDate).toLocaleDateString()}</td>
                    <td>${expense.categoryName}</td>
                    <td>£${expense.amount.toFixed(2)}</td>
                    <td><span class="badge bg-${getStatusColor(expense.statusName)}">${expense.statusName}</span></td>
                    <td>${expense.description || '-'}</td>
                    <td>
                        ${expense.statusName === 'Submitted' ? `
                            <button class="btn btn-sm btn-success" onclick="showApproveModal(${expense.expenseId}, 'approve')">Approve</button>
                            <button class="btn btn-sm btn-danger" onclick="showApproveModal(${expense.expenseId}, 'reject')">Reject</button>
                        ` : ''}
                        ${expense.statusName === 'Draft' ? `
                            <button class="btn btn-sm btn-primary" onclick="submitExpenseForApproval(${expense.expenseId})">Submit</button>
                        ` : ''}
                    </td>
                </tr>
            `).join('');
        }

        function getStatusColor(status) {
            switch (status) {
                case 'Draft': return 'secondary';
                case 'Submitted': return 'warning';
                case 'Approved': return 'success';
                case 'Rejected': return 'danger';
                default: return 'secondary';
            }
        }

        function filterExpenses() {
            const filterText = document.getElementById('filterText').value.toLowerCase();
            const filtered = currentExpenses.filter(expense => 
                expense.categoryName.toLowerCase().includes(filterText) ||
                expense.description?.toLowerCase().includes(filterText) ||
                expense.statusName.toLowerCase().includes(filterText)
            );
            displayExpenses(filtered);
        }

        async function filterByStatus() {
            const status = document.getElementById('statusFilter').value;
            if (!status) {
                loadExpenses();
                return;
            }

            try {
                const response = await fetch(`/api/Expenses/status/${status}`);
                const expenses = await response.json();
                currentExpenses = expenses;
                displayExpenses(expenses);
            } catch (error) {
                console.error('Error filtering by status:', error);
                alert('Failed to filter expenses');
            }
        }

        function clearFilters() {
            document.getElementById('filterText').value = '';
            document.getElementById('statusFilter').value = '';
            loadExpenses();
        }

        async function submitExpense() {
            const expense = {
                userId: 1, // Default user for demo
                categoryId: parseInt(document.getElementById('expenseCategory').value),
                amount: parseFloat(document.getElementById('expenseAmount').value),
                currency: 'GBP',
                expenseDate: document.getElementById('expenseDate').value,
                description: document.getElementById('expenseDescription').value
            };

            try {
                const response = await fetch('/api/Expenses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(expense)
                });

                if (response.ok) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addExpenseModal'));
                    modal.hide();
                    document.getElementById('addExpenseForm').reset();
                    loadExpenses();
                } else {
                    alert('Failed to create expense');
                }
            } catch (error) {
                console.error('Error creating expense:', error);
                alert('Failed to create expense');
            }
        }

        async function submitExpenseForApproval(expenseId) {
            try {
                const response = await fetch(`/api/Expenses/${expenseId}/submit`, {
                    method: 'POST'
                });

                if (response.ok) {
                    loadExpenses();
                } else {
                    alert('Failed to submit expense');
                }
            } catch (error) {
                console.error('Error submitting expense:', error);
                alert('Failed to submit expense');
            }
        }

        function showApproveModal(expenseId, action) {
            currentExpenseId = expenseId;
            const modal = new bootstrap.Modal(document.getElementById('approveModal'));
            
            document.getElementById('approveAction').textContent = action;
            if (action === 'approve') {
                document.getElementById('confirmApprove').style.display = 'inline-block';
                document.getElementById('confirmReject').style.display = 'none';
            } else {
                document.getElementById('confirmApprove').style.display = 'none';
                document.getElementById('confirmReject').style.display = 'inline-block';
            }
            
            modal.show();
        }

        async function confirmApprove() {
            try {
                const response = await fetch(`/api/Expenses/${currentExpenseId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reviewedBy: 2 }) // Default manager for demo
                });

                if (response.ok) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('approveModal'));
                    modal.hide();
                    loadExpenses();
                } else {
                    alert('Failed to approve expense');
                }
            } catch (error) {
                console.error('Error approving expense:', error);
                alert('Failed to approve expense');
            }
        }

        async function confirmReject() {
            try {
                const response = await fetch(`/api/Expenses/${currentExpenseId}/reject`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reviewedBy: 2 }) // Default manager for demo
                });

                if (response.ok) {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('approveModal'));
                    modal.hide();
                    loadExpenses();
                } else {
                    alert('Failed to reject expense');
                }
            } catch (error) {
                console.error('Error rejecting expense:', error);
                alert('Failed to reject expense');
            }
        }

        // Set today's date as default
        document.getElementById('expenseDate').valueAsDate = new Date();
    </script>
}

