@page
@model ChatModel
@{
    ViewData["Title"] = "AI Assistant";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="bi bi-robot"></i> AI Assistant
            </h1>
            <p class="lead">Ask me anything about your expenses!</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-body" style="height: 500px; overflow-y: auto;" id="chatContainer">
                    <div id="chatMessages">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Welcome!</strong> I can help you manage your expenses. Try asking:
                            <ul class="mb-0 mt-2">
                                <li>"Show me all my expenses"</li>
                                <li>"What expenses are pending approval?"</li>
                                <li>"Create an expense for £50 for travel on 2026-01-10"</li>
                                <li>"Show me approved expenses"</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <form id="chatForm" onsubmit="sendMessage(event)">
                        <div class="input-group">
                            <input type="text" id="userInput" class="form-control" placeholder="Type your message..." autocomplete="off">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-send"></i> Send
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chatHistory = [];

        async function sendMessage(event) {
            event.preventDefault();
            
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            // Add user message to UI
            addMessageToUI(message, 'user');
            input.value = '';
            
            // Show typing indicator
            const typingId = addTypingIndicator();
            
            try {
                const response = await fetch('/api/Chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: message,
                        history: chatHistory
                    })
                });
                
                const data = await response.json();
                
                // Remove typing indicator
                removeTypingIndicator(typingId);
                
                // Add assistant response to UI
                addMessageToUI(data.response, 'assistant');
                
                // Update chat history
                chatHistory.push({ role: 'user', content: message });
                chatHistory.push({ role: 'assistant', content: data.response });
                
            } catch (error) {
                removeTypingIndicator(typingId);
                addMessageToUI('Sorry, I encountered an error. Please try again.', 'assistant');
                console.error('Error:', error);
            }
        }
        
        function addMessageToUI(text, role) {
            const container = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `mb-3 ${role === 'user' ? 'text-end' : ''}`;
            
            const bubble = document.createElement('div');
            bubble.className = `d-inline-block p-3 rounded ${role === 'user' ? 'bg-primary text-white' : 'bg-light'}`;
            bubble.style.maxWidth = '80%';
            
            // Format the message
            const formattedText = formatMessage(text);
            bubble.innerHTML = formattedText;
            
            messageDiv.appendChild(bubble);
            container.appendChild(messageDiv);
            
            // Scroll to bottom
            const chatContainer = document.getElementById('chatContainer');
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }
        
        function formatMessage(text) {
            // First, escape HTML to prevent XSS
            let escaped = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
            
            // Then apply markdown-style formatting
            // Bold text
            escaped = escaped.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            
            // Numbered lists
            const lines = escaped.split('\n');
            let inOrderedList = false;
            let inUnorderedList = false;
            let formatted = [];
            
            for (let line of lines) {
                const trimmed = line.trim();
                
                // Check for numbered list
                if (/^\d+\.\s/.test(trimmed)) {
                    if (!inOrderedList) {
                        formatted.push('<ol>');
                        inOrderedList = true;
                    }
                    const content = trimmed.replace(/^\d+\.\s/, '');
                    formatted.push(`<li>${content}</li>`);
                }
                // Check for bullet list
                else if (/^[-*]\s/.test(trimmed)) {
                    if (!inUnorderedList) {
                        if (inOrderedList) {
                            formatted.push('</ol>');
                            inOrderedList = false;
                        }
                        formatted.push('<ul>');
                        inUnorderedList = true;
                    }
                    const content = trimmed.replace(/^[-*]\s/, '');
                    formatted.push(`<li>${content}</li>`);
                }
                else {
                    if (inOrderedList) {
                        formatted.push('</ol>');
                        inOrderedList = false;
                    }
                    if (inUnorderedList) {
                        formatted.push('</ul>');
                        inUnorderedList = false;
                    }
                    if (trimmed) {
                        formatted.push(line + '<br>');
                    }
                }
            }
            
            // Close any open lists
            if (inOrderedList) formatted.push('</ol>');
            if (inUnorderedList) formatted.push('</ul>');
            
            return formatted.join('\n');
        }
        
        function addTypingIndicator() {
            const container = document.getElementById('chatMessages');
            const typingDiv = document.createElement('div');
            const id = 'typing-' + Date.now();
            typingDiv.id = id;
            typingDiv.className = 'mb-3';
            typingDiv.innerHTML = `
                <div class="d-inline-block p-3 rounded bg-light">
                    <div class="typing-indicator">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            `;
            container.appendChild(typingDiv);
            
            const chatContainer = document.getElementById('chatContainer');
            chatContainer.scrollTop = chatContainer.scrollHeight;
            
            return id;
        }
        
        function removeTypingIndicator(id) {
            const element = document.getElementById(id);
            if (element) {
                element.remove();
            }
        }
    </script>
    
    <style>
        .typing-indicator {
            display: inline-flex;
            gap: 4px;
        }
        
        .typing-indicator span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #999;
            animation: typing 1.4s infinite;
        }
        
        .typing-indicator span:nth-child(2) {
            animation-delay: 0.2s;
        }
        
        .typing-indicator span:nth-child(3) {
            animation-delay: 0.4s;
        }
        
        @@keyframes typing {
            0%, 60%, 100% {
                transform: translateY(0);
            }
            30% {
                transform: translateY(-10px);
            }
        }
    </style>
}
